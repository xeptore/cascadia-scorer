{
  "name": "games-scorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p dist/server && cp server/index.js dist/server/index.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:check": "node scripts/verify-icons.mjs",
    "pwa:check": "node scripts/verify-pwa-build.mjs"
  },
  "dependencies": {
    "bits-ui": "^2.18.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "node": "^26.7.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
